      "id": "86fe5371-6d46-5d61-9f08-1648f5a42a3f",
      "name": "Pause rate limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        360
      ],
      "parameters": {
        "jsCode": "// one pause per 60 s per run (MVP.md §7): a burst of out-of-scope writes is one gate, not ten\nconst s = $getWorkflowStaticData('global');\nconst body = $('Webhook').item.json.body;\nconst now = Date.now();\nconst last = (s.lastPause || {})[body.run_id] || 0;\nconst fact = body.traj && body.traj.fact;\nconst pause = !!fact && now - last > 60000;\nif (pause) { s.lastPause = { ...(s.lastPause || {}), [body.run_id]: now }; }\nreturn [{ json: { pause, fact: fact || null, path: body.traj ? body.traj.path : null } }];"
      }
    },
