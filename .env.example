# Copy to .env and fill in. Never commit .env. Every Claude session must ASK for these, never invent them.

# --- OpenAI (Core laptop). Used by the agent-under-watch, claim extractor and Fixer. Needs credit.
OPENAI_API_KEY=
# newest function-calling model on the account; must support tools + json_schema response_format.
# gpt-6-astra and the gpt-5.6-* family are newer but only support function tools via
# /v1/responses on this account, not /v1/chat/completions -- gpt-5.5 is the newest that
# works with our Chat Completions + tools stack. Re-check as new models ship.
OPENAI_MODEL=gpt-5.5

# --- Feature flags (true/false). All false = full replay mode for offline demo.
USE_LLM=false
# which core/fixtures/runs/<name>/transcript.json the harness replays when USE_LLM=false
REPLAY_RUN=clean
USE_N8N=false
USE_SANDBOX=false
USE_BEECEPTOR=false

# --- Core
CORE_BASE_URL=http://localhost:8000
CORE_HOST=0.0.0.0
CORE_PORT=8000

# --- n8n (self-hosted via docker-compose). Webhook path is fixed in MVP.md §7.
N8N_WEBHOOK=http://localhost:5678/webhook/spatial-soc
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# --- Honeypot. Beeceptor endpoint base, e.g. https://<name>.free.beeceptor.com ; local fallback if empty.
HONEYPOT_BASE=

# --- Slack incoming webhook (manual: create in Slack app settings). Used by n8n, also read by core for USE_N8N=false parity.
SLACK_WEBHOOK_URL=

# --- GitHub (manual: fine-grained PAT with pull_requests:write, statuses:write on the demo repo). Used by n8n + Action.
GITHUB_TOKEN=
GITHUB_REPO=owner/spatial-soc

# --- Google Sheets audit (optional; SQLite is the default). Configure inside n8n credentials, not here.

# --- Web
NEXT_PUBLIC_CORE_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CORE_WS_URL=ws://localhost:8000

# --- VR: no secrets. Laptop LAN IP goes in the Unity scene config, not here.
