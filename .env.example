# Copy to .env (repo root) and fill in. Never commit .env. Every value here is read by core/config.py or the web.
# With everything left as-is, the product runs fully offline in replay mode.

# --- LLM (agent-under-watch, claim extractor, Fixer). Needed only for USE_LLM=true.
OPENAI_API_KEY=
# must support tools + json_schema on /v1/chat/completions (see plans/decisions.md for the gpt-5.5 finding)
OPENAI_MODEL=gpt-5.5

# --- Feature flags (true/false). All false = offline replay mode, identical on screen.
USE_LLM=false         # false: runs replay a recording from core/fixtures/runs; claims come from keyword rules
USE_N8N=false         # false: core runs the gate tree itself (UI shows "gates: local")
USE_SANDBOX=false     # false: executions run as local subprocesses under the shim (UI shows "sandbox: subprocess")
USE_BEECEPTOR=false   # false: the core's own honeypot at /honeypot answers all outbound HTTP

# --- Core
CORE_HOST=0.0.0.0
CORE_PORT=8000
CORE_BASE_URL=http://localhost:8000          # how the core, its subprocesses and replay.py reach the core
CORS_ORIGINS=http://localhost:3000           # comma-separated web origins (add the Render URL / LAN IP)
PAUSE_RATE_LIMIT_S=60                        # local gate tree: at most one pause per run per N seconds
MAX_FIX_ITERATIONS=3
MAX_AGENT_TURNS=60
MAX_REPO_FILES=600                           # the city shows at most this many files
EXEC_TIMEOUT_S=120                           # per sandbox execution / agent command
REPLAY_SPEED=4                               # replay pacing vs the recorded run
REPLAY_MIN_GAP_S=0.45
REPLAY_MAX_GAP_S=2.5
# SANDBOX_PYTHON=                            # interpreter for the supervised repo's code (default: the core's)
# RUNS_DIR= / RECORDINGS_DIR= / AUDIT_DB=    # storage locations (defaults under core/)

# --- Sandbox (USE_SANDBOX=true): `cd core && uv run python -m sandbox.docker`, `docker compose up -d honeypot`
SANDBOX_IMAGE=spatial-soc-sandbox
SANDBOX_NETWORK=spatial-soc-sandbox-net
SANDBOX_HONEYPOT_BASE=http://honeypot:8000/honeypot

# --- Honeypot on Beeceptor (USE_BEECEPTOR=true), e.g. https://<name>.free.beeceptor.com
HONEYPOT_BASE=

# --- n8n (USE_N8N=true): `docker compose up -d n8n`, import n8n/workflow.json, activate it
N8N_WEBHOOK=http://localhost:5678/webhook/spatial-soc
N8N_CALLBACK_BASE=http://host.docker.internal:8000   # how the n8n container reaches the core

# --- Slack incoming webhook (manual). Used by core (USE_N8N=false) and by the n8n workflow.
SLACK_WEBHOOK_URL=

# --- GitHub (manual: fine-grained PAT, pull_requests:write + statuses:write). Verdict posted on approve.
GITHUB_TOKEN=

# --- Web (web/.env.local). Defaults to a core on localhost.
NEXT_PUBLIC_CORE_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CORE_WS_URL=ws://localhost:8000

# --- VR: no secrets. Laptop LAN IP goes in the Unity scene config, not here.
